{% extends 'base.html.twig' %}

{% block title %}
  Hello ArticleController!
{% endblock %}

{% block body %}
  <h1>Articles</h1>

  {% for article in articles %}
    <div>
      <p>
        <a href="{{ path('article_item', { slug: article.slug }) }}">{{ article.title }}</a>
      </p>
      <div>{{ article.createdAt|date('d/m/y') }}</div>
    </div>
  {% else %}
    <div>Aucun article trouvé</div>
  {% endfor %}
{% endblock %}
